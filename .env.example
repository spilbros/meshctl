# meshctl deployment configuration.
#
# Copy to .env and edit:  cp .env.example .env
# .env is gitignored — it may hold secrets later (preauth keys, DNS
# API tokens); never commit it.

# Public domain of the headscale control plane. Caddy obtains a
# Let's Encrypt certificate for it, so DNS must already point at this
# host, without CDN proxying (Cloudflare orange-cloud breaks the
# long-lived connections headscale needs).
MESH_DOMAIN=mesh.example.com

# Host ports Caddy publishes. Port 80 is required for ACME HTTP-01
# challenges and the HTTP->HTTPS redirect. Change these only if
# another reverse proxy already owns the defaults on this host.
MESH_HTTP_PORT=80
MESH_HTTPS_PORT=443

# MagicDNS base domain: nodes become <hostname>.<this domain>.
# MUST differ from MESH_DOMAIN and must not be a parent of it
# (headscale refuses to start otherwise).
MESH_BASE_DOMAIN=home.arpa

# Everything else lives in headscale/config.yaml. Any of its settings
# can be overridden without editing the file by adding
# HEADSCALE_<SECTION>_<KEY> to the headscale service environment in
# compose.yaml (e.g. HEADSCALE_LOG_LEVEL=debug) — that is exactly how
# MESH_DOMAIN / MESH_BASE_DOMAIN above are wired in.
